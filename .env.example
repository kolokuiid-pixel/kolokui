# Salin ke .env.local (lokal) dan isi juga di Vercel > Settings > Environment Variables.
# Jangan pernah commit .env.local.

# Supabase > Connect (URL dan publishable key) dan Settings > API Keys (secret key)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# kunci "publishable" (aman dipublikasikan; dipakai browser untuk login pengunjung dan upload bertanda tangan)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# kunci "secret" (RAHASIA, hanya di server)
SUPABASE_SERVICE_ROLE_KEY=

# Login admin. Dua peran, dua password yang BERBEDA:
#   ADMIN_PASSWORD = mengurus tulisan, Pustaka, profil, komentar
#   ROMO_PASSWORD  = semua itu + membaca dan membalas pesan pribadi (isi dan simpan oleh Romo sendiri)
ADMIN_PASSWORD=
ROMO_PASSWORD=
# acak, minimal 16 karakter. Buat dengan: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Tujuan formulir Ajak Bercakap
NEXT_PUBLIC_CONTACT_EMAIL=

# Alamat situs (untuk tautan di email pemberitahuan), contoh https://kolokui.id
NEXT_PUBLIC_SITE_URL=

# OPSIONAL: pemberitahuan email "ada pesan baru" ke Romo dan "Romo membalas" ke pengunjung (lewat Resend).
# Email tidak berisi isi pesan. Pengirim harus dari domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
ROMO_NOTIFY_EMAIL=
